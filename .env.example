# Supabase Configuration
# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anónima (anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role secret key) - requerida para scripts del pipeline y administración
SUPABASE_SERVICE_ROLE_KEY=

# GitHub: el panel /admin lanza las descargas (GitHub Actions → data_pipeline.yml)
# Token "fine-grained" con acceso solo al repo HerScout y permiso Actions: Read and write
GITHUB_TOKEN=
# Opcionales (valores por defecto)
# GITHUB_REPO=scoutingdepartmentfc/HerScout
# GITHUB_REF_NAME=main
